DATABASE_URL=postgres://lunowe@localhost:5432/fitsss
BETTER_AUTH_SECRET=replace-with-64-hex-characters
BETTER_AUTH_URL=http://localhost:3100
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Inference. The provider and the model per task are set in the app under
# You → AI model; only the key has to live here.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Optional pins. Anything set here wins over the app's own setting, so leave
# them blank unless you are deliberately overriding the UI.
#   LLM_PROVIDER      openrouter | anthropic | mock
#   LLM_MODEL_OUTFITS / LLM_MODEL_TASTE / LLM_MODEL_VISION  one model id each
#   LLM_MODEL         the same model for all three (legacy)
#   LLM_EFFORT        low | medium | high
LLM_PROVIDER=
LLM_MODEL=
LLM_MODEL_OUTFITS=
LLM_MODEL_TASTE=
LLM_MODEL_VISION=
LLM_EFFORT=

# Local UI work without a key: deterministic mock outfits, model "mock".
LLM_MOCK=
